<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- user input (usernames, hints) reaches log messages: control characters and line separators are replaced
                 (as LogSanitizer does) so that it cannot forge a record. The stack trace is left as is: it is multi-line
                 by nature and is printed after the message -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %replace(%msg){'[\p{Cntrl}\u0085\u2028\u2029]+', '_'}%n</pattern>
        </encoder>
    </appender>

    <!-- jdbc-proc logs stored procedure arguments (private keys, tokens) at DEBUG -->
    <logger name="com.googlecode.jdbcproc" level="WARN"/>
    <!-- Wicket logs model contents at DEBUG -->
    <logger name="org.apache.wicket" level="WARN"/>
    <!-- CryptoMapper logs a stack trace for every unencrypted URL (favicon.ico etc.); it returns null and the
         request is mapped as is, so the only error it reports is this expected one -->
    <logger name="org.apache.wicket.core.request.mapper.CryptoMapper" level="OFF"/>
    <logger name="org.eclipse.jetty" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
