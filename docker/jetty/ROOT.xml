<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Mort Bay Consulting//DTD Configure//EN"
          "http://www.eclipse.org/jetty/configure.dtd">
<!--
  Jetty context descriptor for ROOT.war.
  Datasource connection parameters are read from environment variables:
    DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD, DB_TIMEZONE
  (not from command-line properties: Jetty echoes unknown arguments into the log,
  which would print the password).
  The datasource is only bound to java:comp/env through the resource-ref in
  override-web.xml, which the Dockerfile generates in ${jetty.base}/etc.
-->
<Configure id='wac' class="org.eclipse.jetty.ee10.webapp.WebAppContext">
    <!-- a context descriptor next to the WAR replaces the automatic WAR deployment, so name the WAR explicitly -->
    <Set name="contextPath">/</Set>
    <Set name="overrideDescriptor"><Property name="jetty.base"/>/etc/override-web.xml</Set>
    <Set name="war"><Property name="jetty.base"/>/webapps/ROOT.war</Set>
    <New id="txDatasource" class="org.eclipse.jetty.plus.jndi.Resource">
        <Arg><Ref refid="wac"/></Arg>
        <Arg>jdbc/superfly</Arg>
        <Arg>
            <New class="org.apache.commons.dbcp2.BasicDataSource">
                <Set name="url">jdbc:mysql://<Env name="DB_HOST" default="mysql"/>:<Env name="DB_PORT" default="3306"/>/<Env name="DB_NAME" default="sso"/>?characterEncoding=utf8&amp;useInformationSchema=true&amp;noAccessToProcedureBodies=false&amp;useLocalSessionState=true&amp;autoReconnect=false&amp;serverTimezone=<Env name="DB_TIMEZONE" default="UTC"/></Set>
                <Set name="driverClassName">com.mysql.cj.jdbc.Driver</Set>
                <Set name="username"><Env name="DB_USER" default="sso"/></Set>
                <Set name="password"><Env name="DB_PASSWORD" default=""/></Set>
                <Set name="accessToUnderlyingConnectionAllowed">true</Set>
                <Set name="testOnBorrow">true</Set>
                <Set name="validationQuery">{call create_collections()}</Set>
            </New>
        </Arg>
    </New>
</Configure>
