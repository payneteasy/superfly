**/*.war
**/*.jar
!install/*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE and editor
.idea/
*.iml
.vscode/
*.swp
*.swo

# AI Factory
.ai-factory/
.claude/
AGENTS.md

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Environment files (never bake into image)
.env
.env.*
!.env.example

# Test artifacts
**/surefire-reports/
**/failsafe-reports/
