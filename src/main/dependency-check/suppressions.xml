<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://www.owasp.org/index.php/OWASP_Dependency_Check_Suppression">
    <!-- superfly-crypto is our own module, not the "PGP" product the CVE/CPE data points at.
         Version-agnostic so it survives module version bumps. -->
    <suppress>
        <notes><![CDATA[
        superfly-crypto is our own helper module, falsely matched against cpe:/a:pgp:pgp.
        ]]></notes>
        <gav regex="true">^com\.payneteasy\.superfly:superfly-crypto:.*$</gav>
        <cpe>cpe:/a:pgp:pgp</cpe>
        <cve>CVE-2001-0265</cve>
    </suppress>

    <!-- bcpg provides the OpenPGP API but is not the vulnerable "openpgp" product.
         Version-agnostic so it survives Bouncy Castle bumps. -->
    <suppress>
        <notes><![CDATA[
        bcpg-jdk18on implements the OpenPGP API but is not the vulnerable OpenPGP product.
        ]]></notes>
        <gav regex="true">^org\.bouncycastle:bcpg-jdk18on:.*$</gav>
        <cpe>cpe:/a:openpgp:openpgp</cpe>
    </suppress>

    <!-- CVE-2016-1000027: Spring Framework 4.x/5.x RCE via HttpInvokerServiceExporter
         deserialization of untrusted data. Superfly does NOT use HttpInvokerServiceExporter,
         RMI or any unsafe deserialization endpoint (the XML/HTTP-invoker remoting stack was
         removed in this refactor — transport is JSON-only). Fixed in Spring 6.x, which is not
         affected; only the EE8 transitive spring-web 5.3.x is flagged. Not exploitable here. -->
    <suppress>
        <notes><![CDATA[
        spring-web 5.3.x (EE8): not exploitable — HttpInvokerServiceExporter/unsafe
        deserialization is not used; HTTP-invoker remoting removed (JSON-only transport).
        ]]></notes>
        <gav regex="true">^org\.springframework:spring-web:5\..*$</gav>
        <cve>CVE-2016-1000027</cve>
    </suppress>

    <!-- TEMPORARY: CVE-2026-22732 (Spring Security HTTP response headers may not be written).
         Fixed in spring-security 5.8.24 / 6.4.15, but those patch artifacts are not yet
         published on Maven Central (latest available: 5.8.16 / 6.4.13, already in use).
         REVISIT and remove this suppression once 6.4.15 / 5.8.24 (or newer in-line) are
         released, then bump spring.security.version / spring-security5.version. -->
    <suppress>
        <notes><![CDATA[
        TEMPORARY: no fixed artifact published yet (need >=5.8.24 / >=6.4.15).
        Remove once the patched spring-security release is available and bumped.
        ]]></notes>
        <gav regex="true">^org\.springframework\.security:spring-security-.*:(5\.8\.|6\.4\.).*$</gav>
        <cve>CVE-2026-22732</cve>
    </suppress>
</suppressions>
