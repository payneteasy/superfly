<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- superfly-crypto is our own module, not the "PGP" product the CVE/CPE data points at.
         Version-agnostic so it survives module version bumps. -->
    <suppress>
        <notes><![CDATA[
        superfly-crypto is our own helper module, falsely matched against cpe:/a:pgp:pgp.
        ]]></notes>
        <gav regex="true">^com\.payneteasy\.superfly:superfly-crypto:.*$</gav>
        <cpe>cpe:/a:pgp:pgp</cpe>
        <cve>CVE-2001-0265</cve>
    </suppress>

    <!-- bcpg provides the OpenPGP API but is not the vulnerable "openpgp" product.
         Version-agnostic so it survives Bouncy Castle bumps. -->
    <suppress>
        <notes><![CDATA[
        bcpg-jdk18on implements the OpenPGP API but is not the vulnerable OpenPGP product.
        ]]></notes>
        <gav regex="true">^org\.bouncycastle:bcpg-jdk18on:.*$</gav>
        <cpe>cpe:/a:openpgp:openpgp</cpe>
    </suppress>

    <!-- CVE-2016-1000027: Spring Framework 4.x/5.x RCE via HttpInvokerServiceExporter
         deserialization of untrusted data. Superfly does NOT use HttpInvokerServiceExporter,
         RMI or any unsafe deserialization endpoint (the XML/HTTP-invoker remoting stack was
         removed in this refactor — transport is JSON-only). Fixed in Spring 6.x, which is not
         affected; only the EE8 transitive spring-web 5.3.x is flagged. Not exploitable here. -->
    <suppress>
        <notes><![CDATA[
        spring-web 5.3.x (EE8): not exploitable — HttpInvokerServiceExporter/unsafe
        deserialization is not used; HTTP-invoker remoting removed (JSON-only transport).
        ]]></notes>
        <gav regex="true">^org\.springframework:spring-web:5\..*$</gav>
        <cve>CVE-2016-1000027</cve>
    </suppress>

    <!-- TEMPORARY: CVE-2026-22732 (Spring Security HTTP response headers may not be written).
         Fixed in spring-security 5.8.24 / 6.4.15, but those patch artifacts are not yet
         published on Maven Central (latest available: 5.8.16 / 6.4.13, already in use).
         REVISIT and remove this suppression once 6.4.15 / 5.8.24 (or newer in-line) are
         released, then bump spring.security.version / spring-security5.version. -->
    <suppress>
        <notes><![CDATA[
        TEMPORARY: no fixed artifact published yet (need >=5.8.24 / >=6.4.15).
        Remove once the patched spring-security release is available and bumped.
        ]]></notes>
        <gav regex="true">^org\.springframework\.security:spring-security-.*:(5\.8\.|6\.4\.).*$</gav>
        <cve>CVE-2026-22732</cve>
    </suppress>

    <!-- ============================================================================
         EE8 provided-scope residual findings (variant B).

         The EE8 wrapper modules (superfly-spring-security-ee8, superfly-wicket-ee8) are
         *published libraries* for external javax.servlet consumers, NOT part of the running
         EE10 SSO server (superfly-web runs on Spring 6 / Wicket 10). Their framework deps were
         switched to <scope>provided</scope>, so Spring 5.x / Wicket 8 are no longer exported
         transitively onto a consumer's compile classpath — the consumer supplies its own
         javax-compatible Spring 5.x / Wicket 8.x.

         skipProvidedScope is intentionally NOT enabled, so the aggregate scan still sees these
         provided deps on the libraries themselves. The suppressions below clear those residual
         findings with the justification "provided, not shipped transitively, not the EE10 runtime".
         Each is VERSION-PINNED so it cannot mask the in-line EE10 stack:
           - spring-core is pinned 5.3.x (spring-core 6.2.18 is clean — must stay visible).
           - spring-security is pinned 5.8.x: CVE-2026-22746 / -22748 are SHARED with the open EE10
             6.4.13 finding; a cve-only or 6.4-matching suppress would hide a real EE10 issue.
         ============================================================================ -->

    <!-- Spring Framework 5.3.x jars (EE8 provided): not exported transitively; not the EE10 runtime
         (Spring Framework 6.2.18 carries none of these). dependency-check attributes these Spring
         Framework CVEs to whichever 5.3.x jar matches the spring_framework CPE (spring-core AND the
         transitive spring-jcl), so the gav is broadened to org.springframework:spring-*:5.3.x.
         Pinned to 5.3 and to the org.springframework groupId so the in-line 6.x stack and the
         org.springframework.security artifacts stay visible. -->
    <suppress>
        <notes><![CDATA[
        Spring Framework 5.3.x jars (EE8): provided in superfly-spring-security-ee8, not exported
        transitively to consumers and not part of the EE10 server runtime (Spring Framework 6.2.18
        is unaffected). Covers spring-core and its transitive spring-jcl, both flagged against the
        same spring_framework CPE at 5.3.39. Version-pinned to 5.3 so the in-line 6.x stack is not masked.
        ]]></notes>
        <gav regex="true">^org\.springframework:spring-.*:5\.3\..*$</gav>
        <cve>CVE-2024-38820</cve>
        <cve>CVE-2026-22735</cve>
        <cve>CVE-2026-22737</cve>
        <cve>CVE-2026-22740</cve>
        <cve>CVE-2026-22741</cve>
        <cve>CVE-2026-22745</cve>
    </suppress>

    <!-- spring-security 5.8.x (EE8 provided): not exported transitively; not the EE10 runtime.
         CVE-2026-22746/-22748 are SHARED with spring-security 6.4.13 — the 6.4.x finding stays
         OPEN (tracked, awaiting patch). MUST pin 5.8 here; cve-only/6.4 match is forbidden. -->
    <suppress>
        <notes><![CDATA[
        spring-security 5.8.x (EE8): provided in superfly-spring-security-ee8, not exported
        transitively and not the EE10 server runtime. CVE-2026-22746/-22748 are shared with the
        open EE10 6.4.13 finding, so this suppress is strictly pinned to 5.8 and must NOT be
        widened to 6.4.x.
        ]]></notes>
        <gav regex="true">^org\.springframework\.security:spring-security-.*:5\.8\..*$</gav>
        <cve>CVE-2026-22746</cve>
        <cve>CVE-2026-22748</cve>
    </suppress>

    <!-- jQuery bundled inside wicket-core 8.x (EE8 provided). The bundled JS is attributed to the
         wicket-core jar, not to our module; it has no Maven GAV identifier, so it is matched by
         filePath (pinned to wicket-core 8.x). Wicket 8 is provided in superfly-wicket-ee8 and not
         exported transitively; the EE10 server runs Wicket 10 (unaffected). Covers both the CVEs
         and the retire.js advisory entries for the bundled jQuery. -->
    <suppress>
        <notes><![CDATA[
        Legacy jQuery bundled in wicket-core 8.x (EE8): wicket is provided in superfly-wicket-ee8,
        not exported transitively, and not the EE10 server runtime (Wicket 10). The bundled jQuery
        is part of the wicket-core jar, not our code.
        ]]></notes>
        <filePath regex="true">^.*wicket-core-8\..*\.jar.*jquery.*\.js$</filePath>
        <cve>CVE-2015-9251</cve>
        <cve>CVE-2019-11358</cve>
        <cve>CVE-2020-11022</cve>
        <cve>CVE-2020-11023</cve>
        <vulnerabilityName regex="true">^jquery issue:.*$</vulnerabilityName>
    </suppress>
</suppressions>
