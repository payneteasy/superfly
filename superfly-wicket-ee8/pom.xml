<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.payneteasy.superfly</groupId>
        <artifactId>superfly-parent</artifactId>
        <version>2.0-3-SNAPSHOT</version>
    </parent>

    <artifactId>superfly-wicket-ee8</artifactId>
    <name>Superfly Wicket extensions (EE8)</name>
    <description>Wicket 8 + Java EE 8 integration helpers for external applications</description>

    <dependencies>
        <dependency>
            <!--
                Justification: Render html UI with Wicket 8 (EE8 / javax.servlet).

                provided: this module is a published library for external javax.servlet consumers, not
                the running EE10 SSO server (which uses Wicket 10). provided keeps Wicket 8 on this
                module's own compile/test classpath but stops it (and its bundled legacy jQuery) from
                being exported transitively onto the consumer's classpath — the consumer brings its own
                javax-compatible Wicket 8.x (variant B, same contract as javax.servlet-api below).
            -->
            <groupId>org.apache.wicket</groupId>
            <artifactId>wicket</artifactId>
            <version>8.18.0</version>
            <type>pom</type>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!--Justification: Java EE 8 Servlet API for EE8 Wicket integration -->
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <!--
                        Variant B guard: Wicket 8 must stay <scope>provided</scope> so it (and its
                        bundled legacy jQuery) is never exported transitively onto an EE8 consumer's
                        classpath. We ban org.apache.wicket ONLY at compile/runtime scope (the
                        exported scopes) — provided/test do not match, so this passes today and
                        fails the build if Wicket is ever switched back to compile or runtime.

                        Note: bannedDependencies in enforcer 3.4.1 has no includeProvidedDependencies
                        flag; scope is matched via the 5th segment of the exclude pattern
                        (groupId:artifactId:version:type:scope:classifier).
                    -->
                    <execution>
                        <id>ban-transitive-wicket-leak</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>org.apache.wicket:*:*:*:compile</exclude>
                                        <exclude>org.apache.wicket:*:*:*:runtime</exclude>
                                    </excludes>
                                    <message>EE8 Wicket deps must stay scope=provided (variant B): Wicket 8 must not leak onto an EE8 consumer's compile/runtime classpath. The consumer brings its own javax-compatible Wicket 8.x.</message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

